{
  "name": "express-typescript-typeorm-boilerplate",
  "version": "1.0.0",
  "description": "RESTful API boilerplate with Typescript, TypeORM, ExpressJs & Mocha.",
  "scripts": {
    "dev": "cross-env NODE_PATH=./src ts-node-dev -r tsconfig-paths/register --respawn ./src/index.ts",
    "build": "rimraf dist && tsc && tsc-alias",
    "start": "cross-env NODE_ENV=production NODE_PATH=./dist node ./dist/index.js",
    "prepare": "husky install",
    "lint": "eslint --max-warnings 0 --ext .js,ts src",
    "lint-staged-husky": "lint-staged",
    "lint-prettier": "prettier --config .prettierrc --list-different '{src,test}/**/*.{ts,js,css,scss}'",
    "prettier": "prettier --config .prettierrc --write './**/*.{ts,js,css,scss,json,md}'",
    "test": "cross-env NODE_PATH=./src mocha --require ts-node/register 'test/integration/**/*.test.ts' --timeout 20000 --exit",
    "commit": "git-cz",
    "docker:dev": "docker-compose --file docker-compose.yml --file docker-compose.dev.yml --compatibility up --build",
    "docker:stage": "docker-compose --file docker-compose.yml --file docker-compose.stage.yml --compatibility up --build",
    "docker:prod": "docker-compose --file docker-compose.yml --file docker-compose.prod.yml --compatibility up --build",
    "migration:run": "cross-env NODE_PATH=./src ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run --config ./src/database/config/ormconfig.ts",
    "migration:run:dev": "cross-env PG_HOST=localhost NODE_PATH=./src ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run --config ./src/database/config/ormconfig.ts",
    "migration:revert": "cross-env PG_HOST=localhost NODE_PATH=./src ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert --config ./src/database/config/ormconfig.ts",
    "migration:generate": "cross-env PG_HOST=localhost NODE_PATH=./src ts-node -r tsconfig-paths/register ./node_modules/.bin/typeorm migration:generate --pretty --config ./src/database/config/ormconfig.ts -n ",
    "migration:create": "cross-env PG_HOST=localhost NODE_PATH=./src ts-node -r tsconfig-paths/register ./node_modules/.bin/typeorm migration:create --config ./src/database/config/ormconfig.ts -n ",
    "seed:run": "cross-env NODE_PATH=./src ts-node -r tsconfig-paths/register ./node_modules/.bin/typeorm migration:run --config ./src/database/config/ormconfig-seed.ts",
    "seed:run:dev": "cross-env PG_HOST=localhost NODE_PATH=./src ts-node -r tsconfig-paths/register ./node_modules/.bin/typeorm migration:run --config ./src/database/config/ormconfig-seed.ts",
    "seed:create": "cross-env PG_HOST=localhost NODE_PATH=./src ts-node -r tsconfig-paths/register ./node_modules/.bin/typeorm migration:create --config ./src/database/config/ormconfig-seed.ts -n "
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/nodemailer": "^7.0.9",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.20",
    "express": "^4.21.2",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.3",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "twilio": "^5.13.0",
    "typeorm": "^0.2.45",
    "typeorm-naming-strategies": "^4.1.0",
    "uuid": "^13.0.0",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^12.1.4",
    "@types/bcryptjs": "^2.4.2",
    "@types/body-parser": "^1.19.0",
    "@types/chai": "^4.2.18",
    "@types/cors": "^2.8.10",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/helmet": "4.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^7.2.0",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "chai": "^6.2.2",
    "commitizen": "^4.2.4",
    "commitlint": "^20.5.0",
    "dotenv": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0",
    "prettier": "^3.8.1",
    "pretty-quick": "^4.2.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*": [
      "pretty-quick --staged"
    ],
    "{src,test}/**/*.{js,ts}": [
      "eslint --max-warnings 0"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-conventional-changelog"
    }
  }
}
