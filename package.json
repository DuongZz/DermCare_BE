{
  "name": "express-typescript-typeorm-boilerplate",
  "version": "1.0.0",
  "description": "RESTful API boilerplate with Typescript, TypeORM, ExpressJs & Mocha.",
  "scripts": {
    "dev": "cross-env NODE_PATH=./src ts-node-dev --respawn ./src/index.ts",
    "build": "rimraf dist && tsc",
    "start": "cross-env NODE_PATH=./dist node ./dist/index.js",
    "prepare": "husky install",
    "lint": "eslint --max-warnings 0 --ext .js,ts src",
    "lint-staged-husky": "lint-staged",
    "lint-prettier": "prettier --config .prettierrc --list-different '{src,test}/**/*.{ts,js,css,scss}'",
    "prettier": "prettier --config .prettierrc --write './**/*.{ts,js,css,scss,json,md}'",
    "test": "cross-env NODE_PATH=./src mocha --require ts-node/register 'test/integration/**/*.test.ts' --timeout 20000 --exit",
    "commit": "git-cz",
    "docker:dev": "docker-compose --file docker-compose.yml --file docker-compose.dev.yml --compatibility up --build",
    "docker:stage": "docker-compose --file docker-compose.yml --file docker-compose.stage.yml --compatibility up --build",
    "docker:prod": "docker-compose --file docker-compose.yml --file docker-compose.prod.yml --compatibility up --build",
    "migration:run": "cross-env NODE_PATH=./src ts-node ./node_modules/typeorm/cli.js migration:run --config ./src/typeorm/config/ormconfig.ts",
    "migration:run:dev": "cross-env PG_HOST=localhost NODE_PATH=./src ts-node ./node_modules/typeorm/cli.js migration:run --config ./src/typeorm/config/ormconfig.ts",
    "migration:revert": "cross-env PG_HOST=localhost NODE_PATH=./src ts-node ./node_modules/typeorm/cli.js migration:revert --config ./src/typeorm/config/ormconfig.ts",
    "migration:generate": "cross-env PG_HOST=localhost NODE_PATH=./src ts-node ./node_modules/.bin/typeorm migration:generate --pretty --config ./src/typeorm/config/ormconfig.ts -n ",
    "migration:create": "cross-env PG_HOST=localhost NODE_PATH=./src ts-node ./node_modules/.bin/typeorm migration:create --config ./src/typeorm/config/ormconfig.ts -n ",
    "seed:run": "cross-env NODE_PATH=./src ts-node ./node_modules/.bin/typeorm migration:run --config ./src/typeorm/config/ormconfig-seed.ts",
    "seed:run:dev": "cross-env PG_HOST=localhost NODE_PATH=./src ts-node ./node_modules/.bin/typeorm migration:run --config ./src/typeorm/config/ormconfig-seed.ts",
    "seed:create": "cross-env PG_HOST=localhost NODE_PATH=./src ts-node ./node_modules/.bin/typeorm migration:create --config ./src/typeorm/config/ormconfig-seed.ts -n "
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/nodemailer": "^7.0.9",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "express": "^4.17.1",
    "helmet": "^4.6.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "minio": "^7.0.26",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "pg": "^8.6.0",
    "reflect-metadata": "^0.1.13",
    "twilio": "^5.12.1",
    "typeorm": "^0.2.34",
    "typeorm-naming-strategies": "^4.1.0",
    "uuid": "^13.0.0",
    "validator": "^13.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^12.1.4",
    "@types/bcryptjs": "^2.4.2",
    "@types/body-parser": "^1.19.0",
    "@types/chai": "^4.2.18",
    "@types/cors": "^2.8.10",
    "@types/express": "^4.17.12",
    "@types/helmet": "4.0.0",
    "@types/jsonwebtoken": "^8.5.1",
    "@types/mocha": "^8.2.2",
    "@types/morgan": "^1.9.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.3",
    "@types/supertest": "^2.0.11",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.1.4",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "chai": "^4.3.4",
    "commitizen": "^4.2.4",
    "dotenv": "^10.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^1.14.0",
    "eslint-plugin-prettier": "^3.4.0",
    "husky": "^6.0.0",
    "lint-staged": "^11.0.0",
    "mocha": "^11.7.5",
    "nyc": "^3.1.0",
    "prettier": "^2.3.1",
    "pretty-quick": "^3.1.0",
    "supertest": "^6.1.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^1.1.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*": [
      "pretty-quick --staged"
    ],
    "{src,test}/**/*.{js,ts}": [
      "eslint --max-warnings 0"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-conventional-changelog"
    }
  }
}
