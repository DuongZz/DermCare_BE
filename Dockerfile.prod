# Stage 1: Builder
FROM node:20-alpine AS builder

WORKDIR /app

# Dependencies needed for native compilation
RUN apk add --no-cache libc6-compat

# Install ALL dependencies (including dev)
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Copy source code and compile TypeScript to JavaScript
COPY . .
RUN npm run build

# Stage 2: Runner (Production)
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV TZ=Asia/Ho_Chi_Minh

# Only root can install some global things, but it's not needed here
# Give the non-root user ownership of the working directory so it can install node_modules
RUN chown node:node /app

# Secure container by switching to the built-in 'node' non-root user
USER node

# Create log directory naturally required by Morgan to stream access outputs
RUN mkdir -p /app/log

# Copy package configurations
COPY --chown=node:node package*.json ./

# Force sequential build to save memory on Render (Wait for builder to finish first)
COPY --from=builder --chown=node:node /app/dist ./dist

# Install strictly production dependencies to keep the image minimal
RUN npm install --legacy-peer-deps --omit=dev --ignore-scripts && npm cache clean --force

EXPOSE 4000

# Run Node.js directly (avoiding npm start footprint)
CMD ["node", "./dist/index.js"]
