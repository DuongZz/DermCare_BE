FROM node:20-alpine

WORKDIR /app

# Add dependencies needed for native modules or dev utilities
RUN apk add --no-cache libc6-compat

# Copy dependency definition
COPY package*.json ./

# Install ALL dependencies (including devDependencies)
# We use npm install instead of npm ci to be faster and more forgiving in dev
RUN npm install --legacy-peer-deps

# We do NOT copy the source code here, because docker-compose.dev.yml 
# will mount your local directory into /app to enable hot-reloading.

EXPOSE 4000

# The startup command (can be overridden by docker-compose)
CMD ["npm", "run", "dev"]
